# HardSecBench Eval System Configuration
# Copy this file to .env and fill in your actual API keys

# ============================================
# Target LLM API Configuration
# ============================================
# Used for the model being evaluated
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Alternative API Providers (uncomment to use):
# SiliconFlow
# OPENAI_API_KEY=your_siliconflow_key
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1/

# Custom Provider
# OPENAI_API_KEY=your_custom_key
# OPENAI_BASE_URL=https://your-provider.com/v1/

# ============================================
# Collaborator Agent Configuration
# ============================================
# Helper agent for code refinement (not evaluated)
# Can use a different API/model than the target LLM
COLLABORATOR_MODEL=gpt-5.1
COLLABORATOR_API_KEY=your_collaborator_api_key_here
COLLABORATOR_BASE_URL=https://api.openai.com/v1

# ============================================
# Transformers Engine Configuration (Optional)
# ============================================
# Only needed if using local transformers models
# Set these as environment variables or in shell scripts

# TARGET_ENGINE=transformers
# TARGET_DEVICE=cuda
# TARGET_BATCH_SIZE=1
# TARGET_MAX_TOKENS=4096
# TARGET_LOAD_IN_8BIT=false
# TARGET_LOAD_IN_4BIT=false
# TARGET_TORCH_DTYPE=bfloat16

# ============================================
# LangSmith Configuration (Optional)
# ============================================
# For tracing and monitoring (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=HardSecBench-Eval
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com